# ─────────────────────────────────────────────────────────────────────────────
# BENCH — environment
#
# The site runs from the committed board in apps/web/data without any of this.
# These are for crawling, probing, and paying.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=56

# Comma-separated, primary first. These are used for eth_call.
# Read endpoints, primary first. Measured on 2026-09-08: blxrbdn answers an
# eth_call in ~170ms where publicnode takes ~550ms, and it is the only host
# tried that also serves deep log ranges. Leaving this blank falls back to
# publicnode, which works and is three times slower — that is what a
# production deployment was doing until it was measured.
BSC_RPC_URL=https://bsc.rpc.blxrbdn.com,https://bsc-dataseed.bnbchain.org,https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Hosts that will actually serve a ranged, filtered eth_getLogs.
#
# Measured against ten public BSC hosts: exactly one answers, and only for the
# most recent window — every offset from 10k blocks to 10M was refused. Without
# an archive node the registry crawl reads the tail and accumulates rather than
# walking history, and /data says so.
# Hosts tried first for ranged eth_getLogs. The default list already puts an
# archive-capable host in front; this is for overriding it.
LOG_RPC_URL=https://bsc.rpc.blxrbdn.com

# Optional. An archive node removes the history limit above; the same code then
# walks as deep as it will serve.
# A host serving history beyond publicnode's ~10,000-block window. One ships
# as a default (bsc.rpc.blxrbdn.com, measured to 208 days at a 5,000-block cap),
# so this is only needed when the free one degrades.
ARCHIVE_RPC_URL=

# ── The registry index ───────────────────────────────────────────────────────
# 8004scan, used for enrichment only. The crawl does not depend on it: it was
# measured answering DATABASE_ERROR on most page sizes and taking about thirty
# seconds on the ones it served, which is why the chain is the authority here.
SCAN_API_KEY=
SCAN_BASE_URL=https://api.8004scan.io/api/v1

# ── B402 Bazaar ──────────────────────────────────────────────────────────────
# Binance's discovery index for paid endpoints. Overridable because a BAPI path
# is not a stable public contract, and a moved path should be a config change.
B402_BAZAAR_URL=https://www.binance.com/bapi/ramp/v1/public/ramp/b402

# ── The site ─────────────────────────────────────────────────────────────────
# Where the reference agents answer. Must be publicly reachable, or the probe
# correctly refuses to list them.
NEXT_PUBLIC_SITE_URL=

# ── Keys (never commit real values) ──────────────────────────────────────────
# Funds the Call rail's float, so a visitor can see the rail work without
# funding a wallet first. Rate-limited, with a balance floor.
BUYER_KEY=

# Submits the EIP-3009 transfer when somebody pays one of our own agents.
# Without it a payment is verified and served but not banked, and the response
# says so rather than dropping it silently.
SETTLER_KEY=

# Where the reference agents are paid.
HOUSE_PAY_TO=

# The reference agents' own wallets, once funded. Absent means the board shows
# them as not funded rather than inventing a track record.
HOUSE_RANGE_I=
HOUSE_RANGE_II=
HOUSE_GRID_I=
HOUSE_GRID_II=
HOUSE_YIELD_I=
HOUSE_YIELD_II=
HOUSE_HEALTH_I=
HOUSE_HEALTH_II=

# Their ERC-8004 registrations, once minted. Absent means not registered — not
# a number reserved.
HOUSE_RANGE_I_TOKEN=

# ── RecipientBound ───────────────────────────────────────────────────────────
# Deployed per (principal, agent) pair. Absent means no wrapper, and the hire
# screen says the recipient rests on account isolation rather than a binding.
RECIPIENT_BOUND=

# ── Worker ───────────────────────────────────────────────────────────────────
CYCLE_MS=900000

# Where the always-on worker publishes its board. Unset means the site reads
# the copy committed in apps/web/data, which is a real board and simply older.
BOARD_URL=
