{
  "name": "bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The place where any agent on BNB Chain can be put to work. Call it, hire it, or mandate it.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@bench/web",
    "build": "NODE_ENV=production npm run build --workspace=@bench/web",
    "start": "NODE_ENV=production npm run start --workspace=@bench/web",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "sweep": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts sweep",
    "probe": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts probe",
    "bazaar": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts bazaar",
    "metrics": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts metrics",
    "snapshot": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts snapshot",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/index.ts",
    "worker:once": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/index.ts --once",
    "prove-scope": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/prove-scope.ts",
    "prove-call": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/prove-call.ts",
    "prove-hire": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/prove-hire.ts",
    "agent": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/run.ts",
    "advantage": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/advantage.ts",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "deploy:wrapper": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/deploy-wrapper.ts",
    "check": "npm run check:diversity && npm run check:measurement && npm run check:absence && npm run check:network && npm run check:ranking && npm run check:routes && npm run check:motion && npm run check:no-lookahead",
    "check:diversity": "tsx tools/checks/diversity.ts",
    "check:measurement": "tsx tools/checks/measurement.ts",
    "check:absence": "tsx tools/checks/absence.ts",
    "check:network": "tsx tools/checks/network.ts",
    "check:ranking": "tsx tools/checks/ranking.ts",
    "check:routes": "tsx tools/checks/routes.ts",
    "check:budget": "node tools/checks/budget.mjs",
    "smoke": "tsx tools/checks/smoke.ts",
    "check:motion": "tsx tools/checks/motion.ts",
    "shots": "node tools/shot.mjs",
    "examples": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts examples",
    "check:no-lookahead": "tsx tools/checks/no-lookahead.ts",
    "counterfactual": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts counterfactual",
    "grade": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts grade",
    "index": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/src/cli.ts index",
    "prove-bond": "npm run contracts:build --silent && tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/agents/src/scripts/prove-bond.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.7.1",
    "@bnbagent/sdk": "^0.5.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.6.1",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.56.3",
    "@bench/counterfactual": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
